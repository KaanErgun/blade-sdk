{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blade-sdk:catalog:1",
  "title": "Signed Blade static catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog", "signature"],
  "properties": {
    "signature": {"type": "string", "minLength": 88, "maxLength": 88, "description": "Base64 Ed25519 signature of the canonical catalog object."},
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "revision", "signer", "packages"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "blade-catalog"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "signer": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "packages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "url", "bytes", "sha256", "signer", "run_as", "permissions"],
            "properties": {
              "id": {"type": "string", "maxLength": 96, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"},
              "version": {"type": "string", "minLength": 5, "maxLength": 64, "description": "SemVer without a v prefix."},
              "url": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https?://", "description": "HTTP(S) package URL without credentials, query or fragment."},
              "bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "signer": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "run_as": {"enum": ["app", "root"]},
              "permissions": {"type": "array", "uniqueItems": true, "items": {"enum": ["camera", "hud", "microphone", "network", "root", "storage"]}}
            },
            "allOf": [{
              "if": {"properties": {"run_as": {"const": "root"}}},
              "then": {"properties": {"permissions": {"contains": {"const": "root"}}}},
              "else": {"properties": {"permissions": {"not": {"contains": {"const": "root"}}}}}
            }]
          }
        }
      }
    }
  },
  "$comment": "The CLI also checks unique app ids and URLs, canonical JSON, size bounds, and the externally trusted Ed25519 key. A catalog verifier does not download packages or enforce persistent anti-rollback policy."
}
